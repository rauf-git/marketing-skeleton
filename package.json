{
  "name": "marketing-skeleton",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @marketing-skeleton/showcase dev",
    "build": "pnpm --filter @marketing-skeleton/showcase build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p apps/showcase/tsconfig.json && tsc --noEmit -p packages/schema/tsconfig.json && tsc --noEmit -p packages/sections/tsconfig.json && tsc --noEmit -p packages/renderer/tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "eslint": "^9.22.0",
    "globals": "^16.0.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.8"
  }
}
